summary(mod2)
summary(mod3)
confint(mod3)
#| label: prepare-nested-tests
tests <- tests |>
select(Df, AIC, BIC, logLik, deviance, Chisq, `Chi Df`, `Pr(>Chisq)`) |>
rename(
Residual.df = Df,
Nested.df = `Chi Df`,
Nested.Chisq.stat = Chisq,
Nested.p.value = `Pr(>Chisq)`
)
#| label: likelihood-nested-tests
tests <- anova(mod0, mod1, mod2, mod3)
tests
#| label: prepare-nested-tests
tests <- tests |>
select(Df, AIC, BIC, logLik, deviance, Chisq, `Chi Df`, `Pr(>Chisq)`) |>
rename(
Residual.df = Df,
Nested.df = `Chi Df`,
Nested.Chisq.stat = Chisq,
Nested.p.value = `Pr(>Chisq)`
)
#| label: extract-model-metrics
glance0 <- glance(mod0)
#| label: extract-model-metrics
glance0 <- broom.mixed::glance(mod0)
glance1 <- broom.mixed::glance(mod1)
glance2 <- broom.mixed::glance(mod2)
glance3 <- broom.mixed::glance(mod3)
#| label: combine-model-metrics
mods <- c(
"M0: Null",
"M1: Satisfaction",
"M2: + Avoidance",
"M3: + Cohabiting"
)
glances <- rbind(
glance0,
glance1,
glance2,
glance3
)
#| label: combine-comparisons
comparison_table <- cbind(
Model = mods,
glances,
tests
)
View(comparison_table)
#| label: model-comparison-table
#| tbl-cap: "Overall model performance and incremental nested-model comparisons"
comparison_table |>
select(
Model,
AIC,
BIC,
logLikelihood,
deviance,
Residual.df,
Nested.df,
Nested.Chisq.stat,
Nested.p.value
) |>
gt() |>
cols_label(
Model = "Model",
AIC = "AIC",
BIC = "BIC",
logLikelihood = "Log-likelihood",
deviance = "Deviance",
Residual.df = "Residual df",
Nested.df = "Nested df",
Nested.Chisq.stat = "Nested χ²",
Nested.p.value = "Nested p"
) |>
fmt_number(
columns = c(
AIC,
BIC,
logLikelihood,
deviance,
Nested.Chisq.stat
),
decimals = 3
) |>
fmt(
columns = Nested.p.value,
fns = function(x) {
ifelse(
is.na(x),
"—",
ifelse(x < .001, "< .001", sprintf("%.3f", x))
)
}
) |>
sub_missing(
columns = c(Nested.df, Nested.Chisq.stat),
missing_text = "—"
)
