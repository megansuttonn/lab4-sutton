  gt() |>
  fmt_number(columns = OR, decimals = 2) |>
  fmt_number(columns = p, decimals = 3) |>
  tab_header(
    title = "Logistic regression of remaining together at 12 months",
    subtitle = "Odds ratios from a binomial GLM with a logit link"
